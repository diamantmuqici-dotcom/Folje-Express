# Required: password for the private /admin panel.
ADMIN_PASSWORD=replace-with-a-strong-private-password

# Vercel Blob storage token (production).
# Without it the app automatically falls back to local file storage
# (./data + ./public/uploads), which is perfect for development.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Public site URL used for SEO (sitemap, robots, canonical, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://folje-express.vercel.app
